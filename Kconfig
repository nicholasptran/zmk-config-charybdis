DT_COMPAT_ZMK_BEHAVIOR_AUTO_SHIFT := zmk,behavior-auto-shift

config ZMK_AUTO_SHIFT
    bool "Global auto shift"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_AUTO_SHIFT))
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      QMK-style global auto shift: holding an eligible key past the tapping term
      types its shifted variant.
