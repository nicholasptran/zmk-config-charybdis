#define DEFAULT 0
#define MOUSE   1
#define SCROLL  2
#define ARROW   3
#define ARROW2  4
#define KEYS_EXCLUDED_FROM_DISABLING_MOUSE_LAYER 22 31 33 34 43 44 49

#include <dt-bindings/zmk/mouse.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors/input_gestures_accel.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Pointer acceleration (oleksandrmaslov/zmk-pointing-acceleration).
// Speeds are raw sensor counts/sec at cpi 1000; factors are x1000.

&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;
    min-factor = <450>;
    max-factor = <2500>;
    speed-threshold = <1200>;
    speed-max = <6000>;
    acceleration-exponent = <2>;
};

&trackball_listener {
    input-processors = <
        &pointer_accel
        &zip_x_scaler 11 10
        &zip_y_scaler 9 10
        &zip_temp_layer MOUSE 400
    >;

    scroller: scroller {
        layers = <SCROLL>;
        input-processors = <
            &zip_xy_scaler 1 15
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};

&lt { tapping-term-ms = <170>; };

/ {
    chosen { zmk,matrix_transform = &default_transform; };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        csharp_lambda {
            bindings = <&csharp_lambda>;
            key-positions = <48 22>;
            layers = <0>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <11 10>;
        };

        parameter_info {
            bindings = <&pi>;
            key-positions = <36 54>;
        };
    };

    macros {
        csharp_lambda: csharp_lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp GT &kp SPACE>;
            label = "CSHARP_LAMBDA";
        };

        pi: parameter_info {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(SPACE))>;
            label = "PARAMETER_INFO";
        };

        ctrl: macro_ctrl_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "MACRO_CTRL_KP";
        };
    };

    behaviors {
        lmt: layer_mouse_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "layer mouse tap";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
        };

        as_tog: auto_shift_toggle {
            compatible = "zmk,behavior-auto-shift";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            enabled-on-boot;
        };
    };

    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <500>;
        excluded-positions = <KEYS_EXCLUDED_FROM_DISABLING_MOUSE_LAYER>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp MINUS      &kp N1  &kp N2  &kp N3        &kp N4       &kp N5        &kp N6         &kp N7     &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB        &kp Q   &kp W   &kp E         &kp R        &kp T         &kp Y          &kp U      &kp I      &kp O    &kp P     &kp BACKSLASH
&kp BACKSPACE  &kp A   &kp S   &kp D         &kp F        &kp G         &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LCTRL      &kp Z   &kp X   &kp C         &kp V        &kp B         &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                               &kp LEFT_ALT  &lt 1 SPACE  &mo 2         &mo 3          &kp ENTER
                                             &gresc       &kp LSHIFT    &kp RIGHT_GUI
            >;

            label = "QWRT";
        };

        mouse_layer {
            bindings = <
&none   &none  &none       &none     &none       &none     &none  &none     &none     &none       &none     &none
&none   &none  &none       &none     &none       &none     &none  &none     &none     &none       &none     &none
&none   &none  &kp C_PREV  &kp C_PP  &kp C_NEXT  &none     &none  &mkp MB5  &none     &lmt 2 MB3  &mkp MB2  &none
&trans  &none  &none       &none     &none       &none     &none  &mkp MB4  &mkp MB1  &none       &none     &none
                           &trans    &none       &none     &none  &none
                                     &none       &trans    &none
            >;

            label = "MOUSE";
        };

        scroll_layer {
            bindings = <
&trans             &kp F1     &kp F2     &kp F3                       &kp F4                         &mt LS(F5) F5    &kp F6     &kp F7  &kp F8  &kp F9  &kp F10    &kp F11
&trans             &kp MINUS  &ctrl W    &mt LEFT_BRACKET LEFT_BRACE  &mt RIGHT_BRACKET RIGHT_BRACE  &kp LC(LS(T))    &kp PSCRN  &kp N7  &kp N8  &kp N9  &kp EQUAL  &kp F12
&kp LC(BACKSPACE)  &kp LC(A)  &kp LC(S)  &kp LEFT_PARENTHESIS         &kp RIGHT_PARENTHESIS          &trans           &trans     &kp N4  &kp N5  &kp N6  &trans     &kp DEL
&bootloader        &kp LC(Z)  &kp LC(X)  &kp LC(C)                    &kp LC(V)                      &trans           &trans     &kp N1  &kp N2  &kp N3  &trans     &trans
                                         &trans                       &trans                         &trans           &trans     &kp N0
                                                                      &trans                         &trans           &trans
            >;

            label = "SCROLL";
        };

        arrow_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &trans             &trans             &trans        &as_tog    &trans     &trans    &trans    &trans     &trans     &trans
&trans      &trans        &kp C_RANDOM_PLAY  &kp C_VOLUME_UP    &kp C_REPEAT  &trans     &kp PSCRN  &trans    &kp UP    &kp EQUAL  &trans     &trans
&trans      &trans        &kp C_PREV         &kp C_PP           &kp C_NEXT    &trans     &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp EQUAL  &trans
&trans      &trans        &trans             &kp C_VOLUME_DOWN  &trans        &trans     &trans     &trans    &trans    &trans     &trans     &bootloader
                                             &trans             &trans        &mo 4      &trans     &trans
                                                                &trans        &trans     &trans
            >;
        };

        arrow_layer2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp PG_UP  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp PG_DN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans   &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
